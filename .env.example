# Copie para .env (que o .gitignore ignora) e exporte as variáveis antes de rodar.
# Nenhum script grava ou imprime estes valores.

# Token da Graph API. Biblioteca de Anúncios: escopo ads_read + identidade verificada.
# Marketing API: escopo ads_management na conta de anúncios.
META_TOKEN=

# Conta de anúncios no formato act_<id> (só para a Marketing API)
META_CONTA=

# Valores trocados nos marcadores {{PAGINA}} e {{INSTAGRAM}} da estrutura de campanhas
META_PAGINA=
META_INSTAGRAM=

# Outros marcadores da estrutura usam o próprio nome como variável (ex.: LINK_SITE, REGIAO)
LINK_SITE=
REGIAO=

# Opcionais
META_API_VERSAO=v21.0
# % da cota em que a coleta faz pausa preventiva de 10 min
LIMITE_PAUSA=85
